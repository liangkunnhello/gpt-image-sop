# 复制为 .env 后填写；不要提交到 Git
# 官方：https://api.openai.com/v1
# 中转：填你自己的 OpenAI 兼容地址（通常以 /v1 结尾）
GPT_IMAGE_BASE_URL=https://api.openai.com/v1
GPT_IMAGE_API_KEY=sk-xxxxxxxxxxxxxxxx
GPT_IMAGE_MODEL=gpt-image-2

# 可选默认值
# GPT_IMAGE_API_MODE=images        # images | responses
# GPT_IMAGE_SIZE=1024x1024
# GPT_IMAGE_QUALITY=high           # low | medium | high
# GPT_IMAGE_OUT=./out
